#!/usr/bin/env python3
"""Manage workspace-wallpaper configuration and portable bundles."""

from __future__ import annotations

import argparse
import math
import zipfile
from pathlib import Path
from typing import Any

from workspace_wallpaper_transfer_lib import (
    CONFIG,
    RANDOM_VALUE,
    export_json,
    export_zip,
    import_json,
    import_zip,
    read_config,
    write_json_atomic,
)


def config_or_default() -> dict[str, Any]:
    if CONFIG.is_file():
        return read_config(CONFIG)
    return {"default": "", "workspaces": {}}


def require_file(raw_path: str, label: str) -> str:
    path = Path(raw_path).expanduser()
    if not path.is_file():
        raise ValueError(f"{label} does not exist: {path}")
    return str(path.resolve())


def nonnegative_number(raw_value: str, label: str) -> float:
    try:
        value = float(raw_value)
    except ValueError as error:
        raise ValueError(f"{label} must be a non-negative number.") from error
    if not math.isfinite(value) or value < 0:
        raise ValueError(f"{label} must be a non-negative number.")
    return value


def set_default(arguments: list[str]) -> None:
    if len(arguments) != 1:
        raise ValueError("set-default requires an image path.")
    config = config_or_default()
    config["default"] = require_file(arguments[0], "Wallpaper")
    write_json_atomic(CONFIG, config)


def set_workspace(arguments: list[str]) -> None:
    if len(arguments) != 2 or not arguments[0]:
        raise ValueError("set requires a workspace and an image path.")
    workspace, raw_path = arguments
    path = raw_path if raw_path == RANDOM_VALUE else require_file(
        raw_path, "Wallpaper"
    )
    config = config_or_default()
    config["workspaces"][workspace] = path
    write_json_atomic(CONFIG, config)


def video_entry(
    arguments: list[str], *, include_workspace: bool
) -> tuple[str | None, dict[str, Any]]:
    minimum = 4 if include_workspace else 3
    maximum = minimum + 3
    if len(arguments) not in (minimum, maximum):
        command = "set-video" if include_workspace else "set-video-default"
        raise ValueError(
            f"{command} requires a video path, frame, and interval."
        )
    offset = 1 if include_workspace else 0
    workspace = arguments[0] if include_workspace else None
    if include_workspace and not workspace:
        raise ValueError("set-video requires a workspace.")
    path = require_file(arguments[offset], "Video")
    frame = nonnegative_number(arguments[offset + 1], "Frame")
    interval = nonnegative_number(arguments[offset + 2], "Interval")
    entry = {
        "type": "video",
        "path": path,
        "themeFrame": frame,
        "interval": interval,
    }
    if len(arguments) == maximum:
        optimized_path = require_file(arguments[offset + 3], "Optimized video")
        optimized_width = int(nonnegative_number(arguments[offset + 4], "Width"))
        optimized_height = int(nonnegative_number(arguments[offset + 5], "Height"))
        if optimized_width <= 0 or optimized_height <= 0:
            raise ValueError("Optimized video dimensions must be positive.")
        entry["optimized"] = {
            "path": optimized_path,
            "width": optimized_width,
            "height": optimized_height,
        }
    return workspace, entry


def set_video_default(arguments: list[str]) -> None:
    _, entry = video_entry(arguments, include_workspace=False)
    config = config_or_default()
    config["default"] = entry
    write_json_atomic(CONFIG, config)


def set_video_workspace(arguments: list[str]) -> None:
    workspace, entry = video_entry(arguments, include_workspace=True)
    config = config_or_default()
    config["workspaces"][workspace] = entry
    write_json_atomic(CONFIG, config)


def set_optimized(arguments: list[str]) -> None:
    if len(arguments) != 4:
        raise ValueError(
            "set-optimized requires a video path, optimized path, width, and height."
        )
    video_path = require_file(arguments[0], "Video")
    optimized_path = require_file(arguments[1], "Optimized video")
    width = int(nonnegative_number(arguments[2], "Width"))
    height = int(nonnegative_number(arguments[3], "Height"))
    if width <= 0 or height <= 0:
        raise ValueError("Optimized video dimensions must be positive.")

    config = config_or_default()
    optimized = {"path": optimized_path, "width": width, "height": height}
    matched = False
    entries = [config.get("default", ""), *config["workspaces"].values()]
    for entry in entries:
        if (
            isinstance(entry, dict)
            and entry.get("type") == "video"
            and isinstance(entry.get("path"), str)
            and str(Path(entry["path"]).expanduser().resolve()) == video_path
        ):
            entry["optimized"] = optimized.copy()
            matched = True
    if not matched:
        raise ValueError(f"Video is not referenced by the config: {video_path}")
    write_json_atomic(CONFIG, config)


def clear_workspace(arguments: list[str]) -> None:
    if len(arguments) != 1 or not arguments[0]:
        raise ValueError("clear requires a workspace.")
    config = config_or_default()
    config["workspaces"].pop(arguments[0], None)
    write_json_atomic(CONFIG, config)


def set_show_workspace_number(arguments: list[str]) -> None:
    if len(arguments) != 1 or arguments[0] not in ("true", "false"):
        raise ValueError(
            "set-show-workspace-number requires true or false."
        )
    config = config_or_default()
    config["showWorkspaceNumber"] = arguments[0] == "true"
    write_json_atomic(CONFIG, config)


def set_workspace_number_position(arguments: list[str]) -> None:
    positions = {
        "top-left", "top-right", "center", "bottom-left", "bottom-right"
    }
    if len(arguments) != 1 or arguments[0] not in positions:
        raise ValueError(
            "set-workspace-number-position requires top-left, top-right, "
            "center, bottom-left, or bottom-right."
        )
    config = config_or_default()
    config["workspaceNumberPosition"] = arguments[0]
    write_json_atomic(CONFIG, config)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=(
        "set-default", "set", "set-video-default", "set-video",
        "set-optimized", "clear", "import-json", "import-zip",
        "export-json", "export-zip", "set-show-workspace-number",
        "set-workspace-number-position",
    ))
    parser.add_argument("arguments", nargs="*")
    arguments = parser.parse_args()
    transfer_actions = {
        "import-json": import_json,
        "import-zip": import_zip,
        "export-json": export_json,
        "export-zip": export_zip,
    }
    mutation_actions = {
        "set-default": set_default,
        "set": set_workspace,
        "set-video-default": set_video_default,
        "set-video": set_video_workspace,
        "set-optimized": set_optimized,
        "clear": clear_workspace,
        "set-show-workspace-number": set_show_workspace_number,
        "set-workspace-number-position": set_workspace_number_position,
    }
    try:
        if arguments.command in transfer_actions:
            if len(arguments.arguments) != 1:
                raise ValueError(f"{arguments.command} requires a path.")
            transfer_actions[arguments.command](
                Path(arguments.arguments[0]).expanduser()
            )
        else:
            mutation_actions[arguments.command](arguments.arguments)
    except (OSError, ValueError, zipfile.BadZipFile) as error:
        parser.exit(1, f"{error}\n")


if __name__ == "__main__":
    main()
