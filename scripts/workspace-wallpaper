#!/usr/bin/env bash

set -u

CONFIG="$HOME/.config/caelestia/workspace-wallpapers.json"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
RANDOM_VALUE="__CAELESTIA_RANDOM__"

WORKSPACE="${1:-}"
[[ -n "$WORKSPACE" ]] || exit 0

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
STATE="$RUNTIME_DIR/caelestia-workspace-wallpaper"
LOCK="$RUNTIME_DIR/caelestia-workspace-wallpaper.lock"

# Record the newest requested workspace.
printf '%s\n' "$WORKSPACE" > "$STATE"

# Debounce quick accidental workspace switching.
sleep 0.20

[[ "$(cat "$STATE" 2>/dev/null)" == "$WORKSPACE" ]] || exit 0
[[ -f "$CONFIG" ]] || exit 0

DEFAULT="$(jq -r '.default // empty' "$CONFIG")"
OVERRIDE="$(jq -r --arg ws "$WORKSPACE" '.workspaces[$ws] // empty' "$CONFIG")"

WALLPAPER="${OVERRIDE:-$DEFAULT}"
[[ -n "$WALLPAPER" ]] || exit 0

# A Random override is resolved every time this workspace is entered.
if [[ "$WALLPAPER" == "$RANDOM_VALUE" ]]; then
    mapfile -d '' WALLPAPERS < <(
        find "$WALLPAPER_DIR" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            -print0
    )

    ((${#WALLPAPERS[@]} > 0)) || exit 0
    WALLPAPER="${WALLPAPERS[RANDOM % ${#WALLPAPERS[@]}]}"
fi

[[ -f "$WALLPAPER" ]] || exit 0

exec 9>"$LOCK"
flock 9

# A newer workspace request may have arrived while waiting for the lock.
[[ "$(cat "$STATE" 2>/dev/null)" == "$WORKSPACE" ]] || exit 0

caelestia wallpaper -f "$WALLPAPER"
