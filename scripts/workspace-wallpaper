#!/usr/bin/env bash
set -u

CONFIG="$HOME/.config/caelestia/workspace-wallpapers.json"
IMAGE_DIR="$HOME/Pictures/Wallpapers"
RANDOM_VALUE="__CAELESTIA_RANDOM__"
MEDIA_HELPER="$HOME/.config/caelestia/scripts/workspace-wallpaper-media"
IPC_HELPER="$HOME/.config/caelestia/scripts/workspace-wallpaper-ipc"
OVERLAY_DIR="$HOME/.config/quickshell/workspace-wallpapers/overlay"

WORKSPACE="${1:-}"
[[ -n "$WORKSPACE" ]] || exit 0
[[ -f "$CONFIG" ]] || exit 0

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
STATE="$RUNTIME_DIR/caelestia-workspace-wallpaper"
OVERLAY_STATE="$RUNTIME_DIR/caelestia-workspace-wallpaper-overlay"
LOCK="$RUNTIME_DIR/caelestia-workspace-wallpaper.lock"
VIDEO_STATE_DIR="$RUNTIME_DIR/caelestia-workspace-wallpaper-video"

mkdir -p "$VIDEO_STATE_DIR"

printf '%s\n' "$WORKSPACE" > "$STATE"

is_current_workspace() {
    local current=""
    IFS= read -r current < "$STATE" 2>/dev/null || return 1
    [[ "$current" == "$WORKSPACE" ]]
}

is_current_workspace || exit 0

mapfile -t OVERLAY_CONFIG < <(
    jq -r '[.showWorkspaceNumber == true,
        (.workspaceNumberPosition // "center")] | .[]' "$CONFIG"
)
SHOW_WORKSPACE_NUMBER="${OVERLAY_CONFIG[0]:-false}"
WORKSPACE_NUMBER_POSITION="${OVERLAY_CONFIG[1]:-center}"
case "$WORKSPACE_NUMBER_POSITION" in
    top-left|top-right|center|bottom-left|bottom-right) ;;
    *) WORKSPACE_NUMBER_POSITION="center" ;;
esac

if [[ "$SHOW_WORKSPACE_NUMBER" == "true" ]]; then
    printf '%s\n%s\n' "$WORKSPACE" "$WORKSPACE_NUMBER_POSITION" > "$OVERLAY_STATE"
    qs -p "$OVERLAY_DIR" -n -d >/dev/null 2>&1 || true
fi

mapfile -t ENTRY_FIELDS < <(
    jq -r \
        --arg ws "$WORKSPACE" \
        --arg random "$RANDOM_VALUE" \
        '(.workspaces[$ws] // .default) as $entry |
         if $entry == null or $entry == ""
         then empty
         elif ($entry | type) == "object"
         then [
             ($entry.type // "image"),
             ($entry.path // ""),
             (($entry.themeFrame // 0) | tostring),
             ($entry.optimized.path // ""),
             (($entry.optimized.width // 0) | tostring),
             (($entry.optimized.height // 0) | tostring)
         ]
         elif $entry == $random
         then ["random", "", "0"]
         else ["image", $entry, "0"]
         end |
         .[]' \
        "$CONFIG"
)

TYPE="${ENTRY_FIELDS[0]:-}"
WALLPAPER="${ENTRY_FIELDS[1]:-}"
FRAME="${ENTRY_FIELDS[2]:-0}"
OPTIMIZED_VIDEO="${ENTRY_FIELDS[3]:-}"
OPTIMIZED_WIDTH="${ENTRY_FIELDS[4]:-0}"
OPTIMIZED_HEIGHT="${ENTRY_FIELDS[5]:-0}"

[[ -n "$TYPE" ]] || exit 0

workspace_output_fields() {
    hyprctl monitors -j 2>/dev/null |
        jq -r \
            --argjson ws "$WORKSPACE" \
            '(([.[] |
               select(.activeWorkspace.id == $ws) |
               .][0]) //
             ([.[] |
               select(.focused == true) |
               .][0])) as $output |
             if $output == null then empty else
                 $output.name,
                 (if (($output.transform // 0) % 2) == 1
                  then $output.height else $output.width end),
                 (if (($output.transform // 0) % 2) == 1
                  then $output.width else $output.height end)
             end'
}

safe_output_name() {
    local value="$1"
    value="${value//[![:alnum:]_.-]/_}"
    printf '%s' "$value"
}

stop_video_for_output() {
    local output="$1"
    local safe
    local pidfile
    local socket
    local pid=""
    local attempt
    local targeted=0
    local arg
    local -a argv=()

    safe="$(safe_output_name "$output")"
    pidfile="$VIDEO_STATE_DIR/$safe.pid"
    socket="$VIDEO_STATE_DIR/$safe.sock"

    if [[ ! -f "$pidfile" ]]; then
        rm -f "$socket"
        return 0
    fi

    IFS= read -r pid < "$pidfile" 2>/dev/null || true
    rm -f "$pidfile" "$socket"

    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    [[ -r "/proc/$pid/cmdline" ]] || return 0

    mapfile -d '' -t argv < "/proc/$pid/cmdline" 2>/dev/null || return 0

    [[ "${argv[0]##*/}" == "mpvpaper" ]] || return 0

    for arg in "${argv[@]}"; do
        if [[ "$arg" == "$output" ]]; then
            targeted=1
            break
        fi
    done

    ((targeted == 1)) || return 0

    kill -TERM "$pid" 2>/dev/null || return 0

    for attempt in {1..4}; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.025
    done

    kill -KILL "$pid" 2>/dev/null || true
}

reuse_video_for_output() {
    local output="$1"
    local video="$2"
    local frame="$3"
    local safe
    local pidfile
    local socket
    local pid=""

    safe="$(safe_output_name "$output")"
    pidfile="$VIDEO_STATE_DIR/$safe.pid"
    socket="$VIDEO_STATE_DIR/$safe.sock"

    [[ -x "$IPC_HELPER" && -f "$pidfile" && -S "$socket" ]] || return 1
    IFS= read -r pid < "$pidfile" 2>/dev/null || return 1
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
    [[ "$(<"/proc/$pid/comm")" == "mpvpaper" ]] || return 1

    "$IPC_HELPER" load "$socket" "$video" "$frame"
}

mapfile -t OUTPUT_FIELDS < <(workspace_output_fields)
OUTPUT="${OUTPUT_FIELDS[0]:-}"
OUTPUT_WIDTH="${OUTPUT_FIELDS[1]:-0}"
OUTPUT_HEIGHT="${OUTPUT_FIELDS[2]:-0}"
[[ -n "$OUTPUT" ]] || exit 0

exec 9>"$LOCK"
flock 9

is_current_workspace || exit 0

case "$TYPE" in
    video)
        VIDEO="$WALLPAPER"

        if [[
            -f "$OPTIMIZED_VIDEO" &&
            "$OPTIMIZED_WIDTH" == "$OUTPUT_WIDTH" &&
            "$OPTIMIZED_HEIGHT" == "$OUTPUT_HEIGHT"
        ]]; then
            VIDEO="$OPTIMIZED_VIDEO"
        fi

        [[ -f "$VIDEO" ]] || exit 0
        [[ -x "$MEDIA_HELPER" ]] || exit 0
        [[ -x "$IPC_HELPER" ]] || exit 0
        command -v mpvpaper >/dev/null 2>&1 || exit 0

        SAFE_OUTPUT="$(safe_output_name "$OUTPUT")"
        PIDFILE="$VIDEO_STATE_DIR/$SAFE_OUTPUT.pid"
        SOCKET="$VIDEO_STATE_DIR/$SAFE_OUTPUT.sock"
        LOGFILE="$VIDEO_STATE_DIR/$SAFE_OUTPUT.log"

        if ! reuse_video_for_output "$OUTPUT" "$VIDEO" "$FRAME"; then
            stop_video_for_output "$OUTPUT"
            rm -f "$SOCKET"

            # fd 9 owns the workspace switch flock. Close it in the child
            # before exec so mpvpaper cannot keep the lock alive after this script exits.
            setsid mpvpaper \
                -o "loop-file=inf no-audio panscan=1.0 hwdec=auto-safe start=$FRAME input-ipc-server=$SOCKET" \
                "$OUTPUT" \
                "$VIDEO" \
                </dev/null \
                >>"$LOGFILE" 2>&1 \
                9>&- &

            MPV_PID=$!
            printf '%s\n' "$MPV_PID" > "$PIDFILE"
        fi

        # Playback is already starting. Update Caelestia's adaptive palette
        # behind mpvpaper without delaying the visible video.
        REFERENCE="$(
            "$MEDIA_HELPER" frame "$VIDEO" "$FRAME"
        )"

        [[ -f "$REFERENCE" ]] || exit 0

        is_current_workspace || exit 0
        caelestia wallpaper -f "$REFERENCE"
        ;;

    random)
        stop_video_for_output "$OUTPUT"

        mapfile -d '' WALLPAPERS < <(
            find "$IMAGE_DIR" -maxdepth 1 -type f \
                \( -iname '*.jpg' -o \
                   -iname '*.jpeg' -o \
                   -iname '*.png' -o \
                   -iname '*.webp' \) \
                -print0
        )

        ((${#WALLPAPERS[@]} > 0)) || exit 0

        RANDOM_INDEX=$((RANDOM % ${#WALLPAPERS[@]}))
        WALLPAPER="${WALLPAPERS[$RANDOM_INDEX]}"

        is_current_workspace || exit 0
        caelestia wallpaper -f "$WALLPAPER"
        ;;

    *)
        [[ -f "$WALLPAPER" ]] || exit 0

        stop_video_for_output "$OUTPUT"

        is_current_workspace || exit 0
        caelestia wallpaper -f "$WALLPAPER"
        ;;
esac
