#!/usr/bin/env bash
set -u

CONFIG="$HOME/.config/caelestia/workspace-wallpapers.json"
IMAGE_DIR="$HOME/Pictures/Wallpapers"
RANDOM_VALUE="__CAELESTIA_RANDOM__"
MEDIA_HELPER="$HOME/.config/caelestia/scripts/workspace-wallpaper-media"
SCHEME_FILE="$HOME/.local/state/caelestia/scheme.json"

WORKSPACE="${1:-}"
[[ -n "$WORKSPACE" ]] || exit 0
[[ -f "$CONFIG" ]] || exit 0

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
STATE="$RUNTIME_DIR/caelestia-workspace-wallpaper"
LOCK="$RUNTIME_DIR/caelestia-workspace-wallpaper.lock"
VIDEO_STATE_DIR="$RUNTIME_DIR/caelestia-workspace-wallpaper-video"

mkdir -p "$VIDEO_STATE_DIR"

printf '%s\n' "$WORKSPACE" > "$STATE"

is_current_workspace() {
    local current=""
    IFS= read -r current < "$STATE" 2>/dev/null || return 1
    [[ "$current" == "$WORKSPACE" ]]
}

is_current_workspace || exit 0

mapfile -t ENTRY_FIELDS < <(
    jq -r \
        --arg ws "$WORKSPACE" \
        --arg random "$RANDOM_VALUE" \
        '(.workspaces[$ws] // .default) as $entry |
         if $entry == null or $entry == ""
         then empty
         elif ($entry | type) == "object"
         then [
             ($entry.type // "image"),
             ($entry.path // ""),
             (($entry.themeFrame // 0) | tostring)
         ]
         elif $entry == $random
         then ["random", "", "0"]
         else ["image", $entry, "0"]
         end |
         .[]' \
        "$CONFIG"
)

TYPE="${ENTRY_FIELDS[0]:-}"
WALLPAPER="${ENTRY_FIELDS[1]:-}"
FRAME="${ENTRY_FIELDS[2]:-0}"

[[ -n "$TYPE" ]] || exit 0

workspace_output() {
    hyprctl monitors -j 2>/dev/null |
        jq -r \
            --argjson ws "$WORKSPACE" \
            '([.[] |
               select(.activeWorkspace.id == $ws) |
               .name][0]) //
             ([.[] |
               select(.focused == true) |
               .name][0]) //
             empty'
}

safe_output_name() {
    local value="$1"
    value="${value//[![:alnum:]_.-]/_}"
    printf '%s' "$value"
}

stop_video_for_output() {
    local output="$1"
    local safe
    local pidfile
    local pid=""
    local attempt
    local targeted=0
    local arg
    local -a argv=()

    safe="$(safe_output_name "$output")"
    pidfile="$VIDEO_STATE_DIR/$safe.pid"

    [[ -f "$pidfile" ]] || return 0

    IFS= read -r pid < "$pidfile" 2>/dev/null || true
    rm -f "$pidfile"

    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    [[ -r "/proc/$pid/cmdline" ]] || return 0

    mapfile -d '' -t argv < "/proc/$pid/cmdline" 2>/dev/null || return 0

    [[ "${argv[0]##*/}" == "mpvpaper" ]] || return 0

    for arg in "${argv[@]}"; do
        if [[ "$arg" == "$output" ]]; then
            targeted=1
            break
        fi
    done

    ((targeted == 1)) || return 0

    kill -TERM "$pid" 2>/dev/null || return 0

    for attempt in {1..4}; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.025
    done

    kill -KILL "$pid" 2>/dev/null || true
}

scheme_stamp() {
    if [[ -f "$SCHEME_FILE" ]]; then
        stat -c '%y:%s' "$SCHEME_FILE" 2>/dev/null
    fi
}

wait_for_scheme_change() {
    local before="$1"
    local current
    local attempt

    for attempt in {1..12}; do
        is_current_workspace || return 1

        current="$(scheme_stamp)"

        if [[ -n "$current" && "$current" != "$before" ]]; then
            return 0
        fi

        sleep 0.05
    done

    return 0
}

OUTPUT="$(workspace_output)"
[[ -n "$OUTPUT" ]] || exit 0

exec 9>"$LOCK"
flock 9

is_current_workspace || exit 0

case "$TYPE" in
    video)
        VIDEO="$WALLPAPER"

        [[ -f "$VIDEO" ]] || exit 0
        [[ -x "$MEDIA_HELPER" ]] || exit 0
        command -v mpvpaper >/dev/null 2>&1 || exit 0

        stop_video_for_output "$OUTPUT"

        REFERENCE="$(
            "$MEDIA_HELPER" frame "$VIDEO" "$FRAME"
        )"

        [[ -f "$REFERENCE" ]] || exit 0
        is_current_workspace || exit 0

        BEFORE_SCHEME="$(scheme_stamp)"

        # Caelestia sees the selected still long enough to update its
        # adaptive palette. mpvpaper is started only after that handoff.
        caelestia wallpaper -f "$REFERENCE"

        wait_for_scheme_change "$BEFORE_SCHEME" || exit 0

        is_current_workspace || exit 0

        SAFE_OUTPUT="$(safe_output_name "$OUTPUT")"
        PIDFILE="$VIDEO_STATE_DIR/$SAFE_OUTPUT.pid"
        LOGFILE="$VIDEO_STATE_DIR/$SAFE_OUTPUT.log"

        # fd 9 owns the workspace switch flock. Close it in the child
        # before exec so mpvpaper cannot keep the lock alive after this script exits.
        setsid mpvpaper \
            -o "loop-file=inf no-audio panscan=1.0 hwdec=auto-safe" \
            "$OUTPUT" \
            "$VIDEO" \
            </dev/null \
            >>"$LOGFILE" 2>&1 \
            9>&- &

        MPV_PID=$!
        printf '%s\n' "$MPV_PID" > "$PIDFILE"
        ;;

    random)
        stop_video_for_output "$OUTPUT"

        mapfile -d '' WALLPAPERS < <(
            find "$IMAGE_DIR" -maxdepth 1 -type f \
                \( -iname '*.jpg' -o \
                   -iname '*.jpeg' -o \
                   -iname '*.png' -o \
                   -iname '*.webp' \) \
                -print0
        )

        ((${#WALLPAPERS[@]} > 0)) || exit 0

        RANDOM_INDEX=$((RANDOM % ${#WALLPAPERS[@]}))
        WALLPAPER="${WALLPAPERS[$RANDOM_INDEX]}"

        is_current_workspace || exit 0
        caelestia wallpaper -f "$WALLPAPER"
        ;;

    *)
        [[ -f "$WALLPAPER" ]] || exit 0

        stop_video_for_output "$OUTPUT"

        is_current_workspace || exit 0
        caelestia wallpaper -f "$WALLPAPER"
        ;;
esac
