#!/usr/bin/env python3

import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

HOME = Path.home()
IMAGE_DIR = HOME / "Pictures" / "Wallpapers"
VIDEO_DIR = HOME / "Videos" / "Wallpapers"
CACHE_ROOT = HOME / ".cache" / "caelestia-workspace-wallpapers" / "videos"

IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp"}
VIDEO_EXTS = {".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi"}

def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)

def run(command):
    return subprocess.run(
        command,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

def cache_dir(path):
    resolved = path.resolve()
    stat = resolved.stat()
    key_source = (
        f"{resolved}\0{stat.st_size}\0{stat.st_mtime_ns}"
    ).encode("utf-8")
    key = hashlib.sha256(key_source).hexdigest()[:24]
    directory = CACHE_ROOT / key
    directory.mkdir(parents=True, exist_ok=True)
    return directory

def video_duration(path, directory=None):
    directory = directory or cache_dir(path)
    metadata = directory / "metadata.json"

    if metadata.is_file():
        try:
            data = json.loads(metadata.read_text())
            return max(0.0, float(data["duration"]))
        except (KeyError, TypeError, ValueError, json.JSONDecodeError):
            pass

    result = run([
        "ffprobe",
        "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1",
        str(path),
    ])

    try:
        duration = max(0.0, float(result.stdout.strip()))
    except ValueError:
        duration = 0.0

    metadata.write_text(json.dumps({"duration": duration}))
    return duration

def video_size(path):
    result = run([
        "ffprobe",
        "-v", "error",
        "-select_streams", "v:0",
        "-show_entries", "stream=width,height",
        "-of", "json",
        str(path),
    ])
    streams = json.loads(result.stdout).get("streams", [])
    if not streams:
        fail(f"Video has no usable video stream: {path}")
    return int(streams[0]["width"]), int(streams[0]["height"])

def extract_scaled(path, seconds, output, width):
    if output.exists() and output.stat().st_size > 0:
        return output

    output.parent.mkdir(parents=True, exist_ok=True)
    temp = output.with_name(output.stem + ".tmp" + output.suffix)

    command = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel", "error",
        "-ss", f"{max(0.0, seconds):.3f}",
        "-i", str(path),
        "-frames:v", "1",
        "-vf", f"scale={width}:-2",
        "-q:v", "4",
        "-y",
        str(temp),
    ]

    try:
        run(command)
        temp.replace(output)
    finally:
        if temp.exists():
            temp.unlink(missing_ok=True)

    return output

def extract_theme_frame(path, seconds, output):
    if output.exists() and output.stat().st_size > 0:
        return output

    output.parent.mkdir(parents=True, exist_ok=True)
    temp = output.with_name(output.stem + ".tmp" + output.suffix)

    command = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel", "error",
        "-ss", f"{max(0.0, seconds):.3f}",
        "-i", str(path),
        "-frames:v", "1",
        "-q:v", "2",
        "-y",
        str(temp),
    ]

    try:
        run(command)
        temp.replace(output)
    finally:
        if temp.exists():
            temp.unlink(missing_ok=True)

    return output

def card_thumbnail(path, duration):
    directory = cache_dir(path)
    output = directory / "card.jpg"
    timestamp = min(1.0, max(0.0, duration * 0.1))
    return extract_scaled(path, timestamp, output, 480)

def scan():
    items = []

    if IMAGE_DIR.exists():
        for path in sorted(IMAGE_DIR.iterdir(), key=lambda p: p.name.lower()):
            if path.is_file() and path.suffix.lower() in IMAGE_EXTS:
                items.append({
                    "type": "image",
                    "path": str(path.resolve()),
                    "thumbnail": str(path.resolve()),
                    "duration": 0,
                })

    if VIDEO_DIR.exists():
        for path in sorted(VIDEO_DIR.iterdir(), key=lambda p: p.name.lower()):
            if not path.is_file() or path.suffix.lower() not in VIDEO_EXTS:
                continue

            try:
                directory = cache_dir(path)
                duration = video_duration(path, directory)
                thumb = card_thumbnail(path, duration)
                items.append({
                    "type": "video",
                    "path": str(path.resolve()),
                    "thumbnail": str(thumb.resolve()),
                    "duration": duration,
                })
            except Exception as exc:
                print(f"Skipping {path.name}: {exc}", file=sys.stderr)

    items.sort(key=lambda item: Path(item["path"]).name.lower())
    print(json.dumps(items, ensure_ascii=False))

def timeline(video, interval):
    path = Path(video).expanduser().resolve()

    if not path.is_file():
        fail(f"Video does not exist: {path}")

    interval = max(1, int(interval))
    directory = cache_dir(path)
    duration = video_duration(path, directory)
    timeline_dir = directory / f"timeline-{interval}"
    timeline_dir.mkdir(parents=True, exist_ok=True)

    frames = sorted(timeline_dir.glob("thumb-*.jpg"))

    if not frames:
        run([
            "ffmpeg",
            "-hide_banner",
            "-loglevel", "error",
            "-i", str(path),
            "-vf", f"fps=1/{interval},scale=320:-2",
            "-q:v", "4",
            "-y",
            str(timeline_dir / "thumb-%06d.jpg"),
        ])
        frames = sorted(timeline_dir.glob("thumb-*.jpg"))

    result = [
        {
            "time": min(float(index * interval), duration),
            "path": str(frame.resolve()),
        }
        for index, frame in enumerate(frames)
    ]

    print(json.dumps({
        "duration": duration,
        "interval": interval,
        "frames": result,
    }, ensure_ascii=False))

def frame(video, seconds):
    path = Path(video).expanduser().resolve()

    if not path.is_file():
        fail(f"Video does not exist: {path}")

    seconds = max(0.0, float(seconds))
    directory = cache_dir(path)
    duration = video_duration(path, directory)

    if duration > 0:
        seconds = min(seconds, max(0.0, duration - 0.001))

    millis = int(round(seconds * 1000))
    output = directory / f"theme-{millis:010d}.jpg"
    extract_theme_frame(path, seconds, output)
    print(str(output.resolve()))

def optimize(video, width, height):
    path = Path(video).expanduser().resolve()

    if not path.is_file():
        fail(f"Video does not exist: {path}")

    width = max(2, int(width)) // 2 * 2
    height = max(2, int(height)) // 2 * 2
    source_width, source_height = video_size(path)

    if source_width <= width and source_height <= height:
        output = path
    else:
        directory = cache_dir(path)
        output = directory / f"matched-{width}x{height}.mp4"

        if not output.is_file() or output.stat().st_size == 0:
            temp = output.with_name(output.stem + ".tmp" + output.suffix)
            filter_graph = (
                f"scale={width}:{height}:force_original_aspect_ratio=increase,"
                f"crop={width}:{height},setsar=1"
            )
            command = [
                "ffmpeg",
                "-hide_banner",
                "-loglevel", "error",
                "-i", str(path),
                "-map", "0:v:0",
                "-vf", filter_graph,
                "-c:v", "libx264",
                "-preset", "veryfast",
                "-crf", "20",
                "-pix_fmt", "yuv420p",
                "-an",
                "-map_metadata", "-1",
                "-movflags", "+faststart",
                "-y",
                str(temp),
            ]

            try:
                run(command)
                temp.replace(output)
            finally:
                if temp.exists():
                    temp.unlink(missing_ok=True)

    print(json.dumps({
        "path": str(output.resolve()),
        "width": width,
        "height": height,
    }, ensure_ascii=False))

def main():
    if len(sys.argv) < 2:
        fail(
            "usage: workspace-wallpaper-media "
            "scan | timeline VIDEO INTERVAL | frame VIDEO SECONDS | "
            "optimize VIDEO WIDTH HEIGHT"
        )

    command = sys.argv[1]

    if command == "scan":
        scan()
    elif command == "timeline" and len(sys.argv) == 4:
        timeline(sys.argv[2], sys.argv[3])
    elif command == "frame" and len(sys.argv) == 4:
        frame(sys.argv[2], sys.argv[3])
    elif command == "optimize" and len(sys.argv) == 5:
        optimize(sys.argv[2], sys.argv[3], sys.argv[4])
    else:
        fail("Invalid workspace-wallpaper-media command.")

if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as exc:
        message = (exc.stderr or "").strip()
        fail(message or f"Command failed: {exc.cmd}")
    except (OSError, ValueError) as exc:
        fail(str(exc))
